{
  "name": "hyh-aliyun-oss-browser",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "description": "HYH OSS Browser monorepo (2.x Electron legacy + 3.x Tauri/Vue)",
  "license": "Apache-2.0",
  "scripts": {
    "sidecar": "npm --prefix apps/transfer-sidecar run start",
    "sidecar:dev": "npm --prefix apps/transfer-sidecar run dev",
    "desktop:dev": "npm --prefix apps/desktop run tauri:dev",
    "desktop:ui": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run tauri:build",
    "legacy:build": "npm --prefix legacy run build --if-present",
    "pack:sidecar": "node scripts/pack-sidecar.cjs"
  }
}
